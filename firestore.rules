rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper for workspaces
    function isWorkspaceMember(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        request.auth.uid in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberIds;
    }

    function isWorkspaceAdminOrOwner(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        (
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.roles[request.auth.uid] == 'owner' ||
          get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.roles[request.auth.uid] == 'admin'
        );
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && (request.resource.data.username == resource.data.username || !exists(/databases/$(database)/documents/usernames/$(request.resource.data.username)));
    }

    // Username reservation
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && username.matches('^[a-z0-9_]{3,20}$')
        && !username.matches('.*__.*')
        && !username.matches('^_.*')
        && !username.matches('.*_$');
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Workspaces collection
    match /workspaces/{workspaceId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.roles[request.auth.uid] == 'owner'
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isSignedIn()
        && (resource.data.roles[request.auth.uid] == 'owner' || resource.data.roles[request.auth.uid] == 'admin' || request.auth.uid in request.resource.data.memberIds);
      allow delete: if false; // soft-delete enforced
    }

    // Invitations collection
    match /invitations/{invitationId} {
      allow read: if isSignedIn()
        && (resource.data.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email || isWorkspaceMember(resource.data.workspaceId));
      allow create: if isSignedIn() && isWorkspaceAdminOrOwner(request.resource.data.workspaceId);
      allow update: if isSignedIn()
        && (resource.data.email == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.email || isWorkspaceAdminOrOwner(resource.data.workspaceId));
      allow delete: if isSignedIn() && isWorkspaceAdminOrOwner(resource.data.workspaceId);
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.ownerId || request.auth.uid in resource.data.memberIds);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.deleted == false
        && request.auth.uid in request.resource.data.memberIds;

      allow update: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || (exists(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)) && get(/databases/$(database)/documents/workspaces/$(resource.data.workspaceId)).data.roles[request.auth.uid] in ['owner', 'admin']));

      allow delete: if false; // soft-delete enforced (updated via field update)
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
      );
    }

    // Tasks collection
    match /tasks/{taskId} {
      // Helper to verify user has access to a project
      function hasProjectAccess(projId) {
        return isSignedIn() && (
          exists(/databases/$(database)/documents/projects/$(projId)) && (
            get(/databases/$(database)/documents/projects/$(projId)).data.ownerId == request.auth.uid ||
            request.auth.uid in get(/databases/$(database)/documents/projects/$(projId)).data.memberIds
          )
        );
      }

      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        hasProjectAccess(resource.data.projectId)
      );

      allow create: if isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.deleted == false &&
        hasProjectAccess(request.resource.data.projectId)
      );

      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        hasProjectAccess(resource.data.projectId)
      );

      allow delete: if false; // soft-delete enforced
    }

    // Notes collection
    match /notes/{noteId} {
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid
      );
      allow update: if isSignedIn() && (
        request.resource.data.ownerId == request.auth.uid
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid
      );
    }
  }
}
